<Window x:Class="AIRewriteAnywhere.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Rewrite — AI Rewrite Anywhere"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Width="640"
        Height="460"
        MinHeight="360"
        MinWidth="480">
    <Border Background="#18181B"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4" Margin="0,0,8,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Preview AI Rewrite" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#71717A"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- Content Area (Side-by-side or stacked) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Original Box -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ORIGINAL TEXT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#71717A"
                               Margin="2,0,0,6"/>
                    <Border Grid.Row="1"
                            Background="#09090B"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <TextBox x:Name="OriginalTextBox"
                                 Background="Transparent"
                                 Foreground="#A1A1AA"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 FontFamily="Segoe UI"/>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#27272A"/>

                <!-- Rewritten Box -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REWRITTEN TEXT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#A78BFA"
                               Margin="2,0,0,6"/>
                    <Border Grid.Row="1"
                            Background="#09090B"
                            BorderBrush="#6D28D9"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <TextBox x:Name="RewrittenTextBox"
                                 Background="Transparent"
                                 Foreground="#FAFAFA"
                                 BorderThickness="0"
                                 IsReadOnly="False"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="You can edit the rewritten text above before replacing."
                           FontSize="11"
                           Foreground="#71717A"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Background="#27272A"
                            Foreground="#E4E4E7"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Padding="16,6"
                            Margin="0,0,10,0"
                            FontSize="13"
                            Cursor="Hand"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                    <Button Content="Replace Selection"
                            Background="#7C3AED"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="18,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            IsDefault="True"
                            Click="Replace_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
