<Window x:Class="AIRewriteAnywhere.UI.RewriteMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Rewrite Menu"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="290"
        SizeToContent="Height"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3F3F46" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181B"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <!-- Normal Menu View -->
            <Grid x:Name="MenuContent" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="4,2,4,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="4" Margin="0,0,6,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="AI Rewrite" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#71717A"
                            FontSize="11"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- Scrollable Options Section -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,0,2,0">
                        <Separator Background="#27272A" Margin="0,0,0,6"/>

                <!-- Primary Rewrite Actions -->
                <Button Content="✨  Improve" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Improve"/>
                <Button Content="💼  Professional" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Professional"/>
                <Button Content="🎓  Academic" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Academic"/>
                <Button Content="📧  Email" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Email"/>
                <Button Content="😊  Friendly" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Friendly"/>
                <Button Content="🙏  Polite" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Polite"/>
                <Button Content="✂  Shorten" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Shorten"/>
                <Button Content="➕  Expand" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Expand"/>
                <Button Content="🔤  Grammar" Style="{StaticResource MenuItemButtonStyle}" Click="Mode_Click" Tag="Grammar"/>

                <Separator Background="#27272A" Margin="0,4"/>

                <!-- Translation Section -->
                <Grid Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🌐 Translate:"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="6,0,8,0"/>
                    <ComboBox x:Name="LanguageCombo"
                              Grid.Column="1"
                              Background="#27272A"
                              Foreground="#FFFFFF"
                              BorderBrush="#3F3F46"
                              FontSize="12"
                              Height="26"
                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                </Grid>

                <Separator Background="#27272A" Margin="0,6"/>

                <!-- Custom Instruction Section -->
                <TextBlock Text="✍ Custom instruction:"
                           Foreground="#A1A1AA"
                           FontSize="11"
                           Margin="6,2,6,4"/>
                <Grid Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomInstructionText"
                             Background="#27272A"
                             Foreground="#FFFFFF"
                             BorderBrush="#3F3F46"
                             BorderThickness="1"
                             FontSize="12"
                             Padding="6,4"
                             Height="28"
                             KeyDown="CustomInstructionText_KeyDown"/>
                    <Button Grid.Column="1"
                            Content="➔"
                            Background="#7C3AED"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Width="28"
                            Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Click="RunCustom_Click"/>
                </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Busy / Progress Overlay -->
            <Grid x:Name="BusyOverlay" Background="#E618181B" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#7C3AED" Opacity="0.5"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Rewriting..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="BusyDetailText"
                               Text="Consulting AI provider..."
                               FontSize="11"
                               Foreground="#A1A1AA"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Button Content="Cancel"
                            Background="#27272A"
                            Foreground="#E4E4E7"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Padding="16,5"
                            FontSize="12"
                            Cursor="Hand"
                            Click="CancelRewrite_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
