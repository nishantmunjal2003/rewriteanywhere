<Window x:Class="AIRewriteAnywhere.UI.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Rewrite Button"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="FloatingButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#EE1E1F29"
                                BorderBrush="#667C3AED"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Color="#8B5CF6"
                                                  Opacity="0.45"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="✨"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#A78BFA"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2D1B69"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA78BFA"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="3"
                                                          Direction="270"
                                                          Color="#A78BFA"
                                                          Opacity="0.75"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E1035"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Button x:Name="ActionButton"
                Style="{StaticResource FloatingButtonStyle}"
                ToolTip="AI Rewrite (Click to rewrite selection)"
                Click="ActionButton_Click"/>
    </Grid>
</Window>
