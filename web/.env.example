# Google OAuth Client ID for Admin Authentication
# Create in Google Cloud Console: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application
# Authorized JavaScript origins:
#   - https://rewriteanywhere.nishantmunjal.com
#   - http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server Session & License HMAC Secret
ADMIN_SESSION_SECRET=arw-admin-secure-session-key-2026
LICENSE_HMAC_SECRET=arw-hmac-secret-token-key-2026

# Admin Authorization (comma-separated authorized admin emails)
ADMIN_EMAIL=admin@biopge.com,nishantmunjal2003@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@biopge.com,nishantmunjal2003@gmail.com

# ZeptoMail Configuration
ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=noreply@biopge.com
ZEPTOMAIL_FROM_NAME="Rewrite Anywhere"
QUEUE_CONNECTION=sync

