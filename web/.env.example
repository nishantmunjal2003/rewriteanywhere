# Google OAuth Client ID for Admin Authentication
# Create in Google Cloud Console: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application
# Authorized JavaScript origins:
#   - https://rewriteanywhere.nishantmunjal.com
#   - http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server Session & License HMAC Secret
ADMIN_SESSION_SECRET=arw-admin-secure-session-key-2026
LICENSE_HMAC_SECRET=arw-hmac-secret-token-key-2026
